{
  "name": "colin-student-living",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:server": "prisma generate",
    "start": "tsx src/server/server.ts",
    "start:server": "tsx src/server/server.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/test/database/** --exclude src/test/api/** --exclude src/test/auth/auth-integration.test.ts --exclude src/test/auth/auth-adversarial.test.ts --exclude src/test/marketplace/** --exclude src/test/storage/photo-upload.integration.test.ts --exclude src/test/location/geospatial-search.integration.test.ts --exclude src/test/location/location-compliance.integration.test.ts --exclude src/test/email/*.integration.test.ts --exclude src/test/email/email-auth-integration.test.ts",
    "test:db:integration": "vitest run src/test/database/postgres-integrity.integration.test.ts --fileParallelism=false",
    "test:orm:integration": "vitest run src/test/database/backend-orm-integration.test.ts --fileParallelism=false",
    "test:api:integration": "vitest run src/test/api/backend-core-api.integration.test.ts --fileParallelism=false",
    "test:auth:integration": "vitest run src/test/auth/auth-integration.test.ts --fileParallelism=false",
    "test:auth:adversarial": "vitest run src/test/auth/auth-adversarial.test.ts --fileParallelism=false",
    "test:marketplace:integration": "vitest run src/test/marketplace/marketplace-business.integration.test.ts --fileParallelism=false",
    "test:marketplace:adversarial": "vitest run src/test/marketplace/marketplace-adversarial.test.ts --fileParallelism=false",
    "test:storage:unit": "vitest run src/test/storage/image-pipeline.test.ts src/test/storage/storage-provider.test.ts",
    "test:storage:integration": "vitest run src/test/storage/photo-upload.integration.test.ts --fileParallelism=false",
    "test:location:unit": "vitest run src/test/location/location-provider.test.ts src/test/location/geospatial-math.test.ts",
    "test:location:integration": "vitest run src/test/location/geospatial-search.integration.test.ts --fileParallelism=false",
    "test:location:compliance": "vitest run src/test/location/location-compliance.integration.test.ts --fileParallelism=false",
    "test:email:unit": "vitest run src/test/email/email-provider.test.ts src/test/email/email-template.test.ts",
    "test:email:integration": "vitest run src/test/email/email-outbox.integration.test.ts src/test/email/email-webhook.integration.test.ts src/test/email/email-auth-integration.test.ts --fileParallelism=false",
    "test:email": "vitest run src/test/email/ --fileParallelism=false",
    "test:redis": "vitest run src/test/redis/ --fileParallelism=false",
    "test:security": "vitest run src/test/security/ --fileParallelism=false",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^11.11.17",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "multer": "^2.5.0",
    "pg": "8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/pg": "8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
