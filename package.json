{
  "name": "colin-student-living",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/test/database/** --exclude src/test/api/** --exclude src/test/auth/auth-integration.test.ts --exclude src/test/auth/auth-adversarial.test.ts --exclude src/test/marketplace/**",
    "test:db:integration": "vitest run src/test/database/postgres-integrity.integration.test.ts --fileParallelism=false",
    "test:orm:integration": "vitest run src/test/database/backend-orm-integration.test.ts --fileParallelism=false",
    "test:api:integration": "vitest run src/test/api/backend-core-api.integration.test.ts --fileParallelism=false",
    "test:auth:integration": "vitest run src/test/auth/auth-integration.test.ts --fileParallelism=false",
    "test:auth:adversarial": "vitest run src/test/auth/auth-adversarial.test.ts --fileParallelism=false",
    "test:marketplace:integration": "vitest run src/test/marketplace/marketplace-business.integration.test.ts --fileParallelism=false",
    "test:marketplace:adversarial": "vitest run src/test/marketplace/marketplace-adversarial.test.ts --fileParallelism=false",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^11.11.17",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "pg": "8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
