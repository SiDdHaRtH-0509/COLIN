// =============================================================================
// COLIN PLATFORM — CENTRAL DATABASE SCHEMA (PRISMA ORM / POSTGRESQL 16+)
// Phase 4A.2.2.1-R2 Hardening & Verification Specification
// Single Source of Truth for Public, Student, Owner, and Admin Control Centre
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

