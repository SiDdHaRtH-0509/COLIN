# =============================================================================
# COLIN Platform Environment Configuration Template
# =============================================================================
# Note: Copy this file to .env and provide your local credentials.
# Do NOT commit .env or real credentials to source control.

# PostgreSQL Connection String (Local Test Instance)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgresql://postgres:<REDACTED_PASSWORD>@127.0.0.1:5433/colin_test?schema=public"

# Application Environment
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Cloud Image Storage Configuration (Phase 4A.2.5.1)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="local" # Options: 'local' (development/testing) or 's3' (production)
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB upload ceiling

# Production AWS S3 / Cloudflare R2 / MinIO Credentials (Required if STORAGE_PROVIDER="s3")
S3_BUCKET="colin-property-photos-prod"
S3_REGION="ap-south-1" # e.g. AWS Mumbai region for Indian student accommodation
S3_ENDPOINT="" # Optional custom endpoint (e.g. https://<account_id>.r2.cloudflarestorage.com or http://localhost:9000 for MinIO)
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
STORAGE_PUBLIC_BASE_URL="" # Optional public CDN domain (e.g. https://cdn.colin.in/properties)

# -----------------------------------------------------------------------------
# Google Maps & Geolocation Infrastructure (Phase 4A.2.5.2)
# -----------------------------------------------------------------------------
GEOLOCATION_PROVIDER="mock" # Options: 'mock' (development/testing) or 'google' (production)

# Backend Server Key (Never expose to client bundles or frontend responses)
# Requires Geocoding API & Places API (New) enabled, restricted by IP in Google Cloud Console
GOOGLE_MAPS_SERVER_KEY="your-backend-google-maps-api-key"

# Frontend Browser Key (Exposed via Vite for Maps JavaScript SDK only)
# Restricted by HTTP Referrer (e.g., https://colin.in/*, http://localhost:5173/*)
VITE_GOOGLE_MAPS_BROWSER_KEY="your-browser-restricted-google-maps-api-key"

# -----------------------------------------------------------------------------
# Transactional Email Infrastructure (Phase 4A.2.5.3)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="mock" # Options: 'mock' (development/testing), 'sendgrid', or 'postmark'

# Sender Configuration
EMAIL_FROM_ADDRESS="no-reply@colin.in"
EMAIL_FROM_NAME="COLIN — Campus Living Verified"
EMAIL_REPLY_TO="support@colin.in"
EMAIL_PUBLIC_BASE_URL="http://localhost:5173" # Base URL used for email action links (verification, password reset)

# Production SendGrid Credentials (Required if EMAIL_PROVIDER="sendgrid")
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_WEBHOOK_VERIFICATION_KEY="your-sendgrid-event-webhook-public-key"

# Production Postmark Credentials (Required if EMAIL_PROVIDER="postmark")
POSTMARK_SERVER_TOKEN="your-postmark-server-api-token"

# Inbound Webhook Basic Authentication Credentials (Postmark Webhook Endpoint)
EMAIL_WEBHOOK_BASIC_AUTH_USER="colin-webhook-admin"
EMAIL_WEBHOOK_BASIC_AUTH_PASSWORD="your-strong-webhook-password-min8chars"

# Email Worker Concurrency & Retry Settings
EMAIL_WORKER_ENABLED="false" # Enable background queue worker
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BASE_DELAY_MS=30000 # 30 seconds base delay with exponential backoff
EMAIL_BATCH_SIZE=20

# -----------------------------------------------------------------------------
# Redis Distributed Rate Limiting Infrastructure (Phase 4A.2.5.4)
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="" # Optional authentication password
REDIS_DB=0
REDIS_KEY_PREFIX="colin:"
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_MAX_RETRIES=5
REDIS_RETRY_BASE_DELAY_MS=100

# Rate Limiter Controls & Security Modes
RATE_LIMIT_ENABLED="true" # Set to 'false' to disable rate limiting (testing/dev)
RATE_LIMIT_FAIL_MODE="closed" # Security mode: 'closed' (reject on Redis outage) or 'open' (allow on Redis outage)
RATE_LIMIT_IDENTITY_HMAC_SECRET="your-secret-hmac-key-minimum-16-characters" # Used to HMAC-hash account emails
TRUSTED_PROXIES="127.0.0.1,::1,::ffff:127.0.0.1" # Comma-separated list of trusted reverse proxy IPs



