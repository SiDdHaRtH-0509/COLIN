# =============================================================================
# COLIN Platform Environment Configuration Template
# =============================================================================
# Note: Copy this file to .env and provide your local credentials.
# Do NOT commit .env or real credentials to source control.

# PostgreSQL Connection String (Local Test Instance)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgresql://postgres:<REDACTED_PASSWORD>@127.0.0.1:5433/colin_test?schema=public"

# Application Environment
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Cloud Image Storage Configuration (Phase 4A.2.5.1)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="local" # Options: 'local' (development/testing) or 's3' (production)
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB upload ceiling

# Production AWS S3 / Cloudflare R2 / MinIO Credentials (Required if STORAGE_PROVIDER="s3")
S3_BUCKET="colin-property-photos-prod"
S3_REGION="ap-south-1" # e.g. AWS Mumbai region for Indian student accommodation
S3_ENDPOINT="" # Optional custom endpoint (e.g. https://<account_id>.r2.cloudflarestorage.com or http://localhost:9000 for MinIO)
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
STORAGE_PUBLIC_BASE_URL="" # Optional public CDN domain (e.g. https://cdn.colin.in/properties)

# -----------------------------------------------------------------------------
# Google Maps & Geolocation Infrastructure (Phase 4A.2.5.2)
# -----------------------------------------------------------------------------
GEOLOCATION_PROVIDER="mock" # Options: 'mock' (development/testing) or 'google' (production)

# Backend Server Key (Never expose to client bundles or frontend responses)
# Requires Geocoding API & Places API (New) enabled, restricted by IP in Google Cloud Console
GOOGLE_MAPS_SERVER_KEY="your-backend-google-maps-api-key"

# Frontend Browser Key (Exposed via Vite for Maps JavaScript SDK only)
# Restricted by HTTP Referrer (e.g., https://colin.in/*, http://localhost:5173/*)
VITE_GOOGLE_MAPS_BROWSER_KEY="your-browser-restricted-google-maps-api-key"

